{
  "name": "pumpkin-court",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "test": "node --import tsx --test src/*.test.ts",
    "start": "tsx server/index.ts --production",
    "generate:herald": "tsx server/generate-herald.ts"
  },
  "dependencies": {
    "@livekit/components-react": "2.9.24",
    "@runwayml/avatars-node-rpc": "0.1.0",
    "@runwayml/avatars-react": "0.17.0",
    "@runwayml/sdk": "4.24.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "livekit-client": "2.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "description": "A local Halloween carving competition with a live Runway avatar judge, scoring tools and downloadable scorecards.",
  "engines": {
    "node": ">=22.22.0"
  }
}
